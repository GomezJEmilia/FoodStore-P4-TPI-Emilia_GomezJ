# REST Client de VSCode. Ejecutar en orden, con backend iniciado y seed ejecutado.
# Cambiar marca si se repite el archivo: el registro no borra cuentas anteriores.
# Si cambiaste SEED_ADMIN_PASSWORD, ajustar adminPassword.
@baseUrl = http://localhost:8000/api/v1
@marca = 01
@cliente = cliente_fase5_{{marca}}
@password = Cliente123!
@adminPassword = Admin1234!

### 01. Limpiar sesión anterior — 200
POST {{baseUrl}}/auth/logout

### 02. Perfil sin sesión — 401
GET {{baseUrl}}/auth/me

### 03. Registro público — 201; role debe ser user
# @name registrarCliente
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "{{cliente}}",
  "full_name": "Cliente de prueba",
  "email": "cliente.fase5.{{marca}}@example.com",
  "password": "{{password}}"
}

### 04. Registro duplicado — 409
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "{{cliente}}",
  "full_name": "Cliente de prueba",
  "email": "cliente.fase5.{{marca}}@example.com",
  "password": "{{password}}"
}

### 05. Contraseña corta — 422
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "invalido",
  "full_name": "Cliente de prueba",
  "email": "invalido@example.com",
  "password": "corta"
}

### 06. Intento de asignarse admin — 422, campo extra rechazado
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "no_admin",
  "full_name": "Cliente de prueba",
  "email": "no.admin@example.com",
  "password": "Cliente123!",
  "role": "admin"
}

### 07. Login incorrecto — 401
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username={{cliente}}&password=Incorrecta123!

### 08. Login enviado como JSON — 422; debe usarse formulario
POST {{baseUrl}}/auth/token
Content-Type: application/json

{"username":"{{cliente}}","password":"{{password}}"}

### 09. Login cliente — 200; Set-Cookie HttpOnly, sin token en JSON
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username={{cliente}}&password={{password}}

### 10. Perfil cliente — 200
GET {{baseUrl}}/auth/me

### 11. Cliente intenta listar usuarios — 403
GET {{baseUrl}}/admin/usuarios

### 12. Logout cliente — 200
POST {{baseUrl}}/auth/logout

### 13. Login administrador del seed — 200
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password={{adminPassword}}

### 14. Perfil admin — 200
# @name perfilAdmin
GET {{baseUrl}}/auth/me

### 15. Listar usuarios — 200
GET {{baseUrl}}/admin/usuarios

### 16. Autodesactivación — 400
POST {{baseUrl}}/admin/usuarios/{{perfilAdmin.response.body.$.id}}/desactivar

### 17. Activar usuario inexistente — 404
POST {{baseUrl}}/admin/usuarios/999999/activar

### 18. Desactivar cliente — 200; disabled debe ser true
POST {{baseUrl}}/admin/usuarios/{{registrarCliente.response.body.$.id}}/desactivar

### 19. Repetir desactivación — 200, idempotente
POST {{baseUrl}}/admin/usuarios/{{registrarCliente.response.body.$.id}}/desactivar

### 20. Logout admin — 200
POST {{baseUrl}}/auth/logout

### 21. Login cliente desactivado — 400
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username={{cliente}}&password={{password}}

### 22. Login admin — 200
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password={{adminPassword}}

### 23. Activar cliente — 200; disabled debe ser false
POST {{baseUrl}}/admin/usuarios/{{registrarCliente.response.body.$.id}}/activar

### 24. Repetir activación — 200, idempotente
POST {{baseUrl}}/admin/usuarios/{{registrarCliente.response.body.$.id}}/activar

### 25. Logout admin — 200
POST {{baseUrl}}/auth/logout

### 26. Login cliente reactivado — 200
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username={{cliente}}&password={{password}}

### 27. Perfil cliente — 200
GET {{baseUrl}}/auth/me

### 28. Logout final — 200
POST {{baseUrl}}/auth/logout

### 29. Perfil tras logout — 401
GET {{baseUrl}}/auth/me
