
@baseUrl = http://localhost:8000/api/v1
@marca = fase7_001

### 1. Login admin — 200
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password=Admin1234!

### 2. Categoría — 201
# @name categoriaPedidos
POST {{baseUrl}}/categorias
Content-Type: application/json

{"nombre":"Pedidos {{marca}}"}

### 3. Producto con stock 10 — 201
# @name productoPedidos
POST {{baseUrl}}/productos
Content-Type: application/json

{"nombre":"Café {{marca}}","precio_base":100.5,"stock":10,"categoria_id":{{categoriaPedidos.response.body.$.id}}}

### 4. Registrar cliente A — 201
POST {{baseUrl}}/auth/register
Content-Type: application/json

{"username":"cliente_{{marca}}","full_name":"Cliente A","email":"cliente_{{marca}}@example.com","password":"Password123!"}

### 5. Login cliente A — 200, reemplaza cookie admin
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=cliente_{{marca}}&password=Password123!

### 6. Pedidos antes de compra fallida — 200, total 0 para esta cuenta nueva
GET {{baseUrl}}/pedidos

### 7. Stock antes de compra fallida — 200, stock 10
GET {{baseUrl}}/productos/{{productoPedidos.response.body.$.id}}

### 8. Fallo tras procesar producto válido — 404, debe revertir todo
POST {{baseUrl}}/pedidos
Content-Type: application/json

{"items":[{"producto_id":{{productoPedidos.response.body.$.id}},"cantidad":2},{"producto_id":2147483647,"cantidad":1}],"forma_pago":"EFECTIVO","direccion_entrega":"Calle Mendoza 123"}

### 9. Sin pedido parcial — 200, total 0
GET {{baseUrl}}/pedidos

### 10. Sin descuento parcial — 200, stock 10
GET {{baseUrl}}/productos/{{productoPedidos.response.body.$.id}}

### 11. Repetido — 400
POST {{baseUrl}}/pedidos
Content-Type: application/json

{"items":[{"producto_id":{{productoPedidos.response.body.$.id}},"cantidad":1},{"producto_id":{{productoPedidos.response.body.$.id}},"cantidad":1}],"forma_pago":"EFECTIVO","direccion_entrega":"Calle Mendoza 123"}

### 12. Stock insuficiente — 400
POST {{baseUrl}}/pedidos
Content-Type: application/json

{"items":[{"producto_id":{{productoPedidos.response.body.$.id}},"cantidad":11}],"forma_pago":"EFECTIVO","direccion_entrega":"Calle Mendoza 123"}

### 13. Sin ítems — 422
POST {{baseUrl}}/pedidos
Content-Type: application/json

{"items":[],"forma_pago":"EFECTIVO","direccion_entrega":"Calle Mendoza 123"}

### 14. Compra válida — 201, total 201, usuario de sesión
# @name pedidoCliente
POST {{baseUrl}}/pedidos
Content-Type: application/json

{"items":[{"producto_id":{{productoPedidos.response.body.$.id}},"cantidad":2}],"forma_pago":"EFECTIVO","direccion_entrega":"Calle Mendoza 123"}

### 15. Descuento confirmado — 200, stock 8
GET {{baseUrl}}/productos/{{productoPedidos.response.body.$.id}}

### 16. Propio — 200, snapshots Café y 100.5
GET {{baseUrl}}/pedidos/{{pedidoCliente.response.body.$.id}}

### 17. User no cambia estados por ruta admin — 403
PATCH {{baseUrl}}/pedidos/{{pedidoCliente.response.body.$.id}}/estado
Content-Type: application/json

{"estado":"EN_PREPARACION"}

### 18. User no consulta resumen — 403
GET {{baseUrl}}/pedidos/resumen

### 19. Registro cliente B — 201
POST {{baseUrl}}/auth/register
Content-Type: application/json

{"username":"otro_{{marca}}","full_name":"Cliente B","email":"otro_{{marca}}@example.com","password":"Password123!"}

### 20. Login B — 200
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=otro_{{marca}}&password=Password123!

### 21. Listado B — 200, total 0
GET {{baseUrl}}/pedidos

### 22. Pedido ajeno — 403
GET {{baseUrl}}/pedidos/{{pedidoCliente.response.body.$.id}}

### 23. Cancelar ajeno — 403
PATCH {{baseUrl}}/pedidos/{{pedidoCliente.response.body.$.id}}/cancelar

### 24. Volver a A — 200
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=cliente_{{marca}}&password=Password123!

### 25. Cancelar propio pendiente — 200
PATCH {{baseUrl}}/pedidos/{{pedidoCliente.response.body.$.id}}/cancelar

### 26. Stock restituido — 200, stock 10
GET {{baseUrl}}/productos/{{productoPedidos.response.body.$.id}}

### 27. Repetir cancelación — 400
PATCH {{baseUrl}}/pedidos/{{pedidoCliente.response.body.$.id}}/cancelar

### 28. Sin doble devolución — 200, stock 10
GET {{baseUrl}}/productos/{{productoPedidos.response.body.$.id}}

### 29. Segunda compra — 201
# @name pedidoEntregado
POST {{baseUrl}}/pedidos
Content-Type: application/json

{"items":[{"producto_id":{{productoPedidos.response.body.$.id}},"cantidad":1}],"forma_pago":"TRANSFERENCIA","direccion_entrega":"Calle Mendoza 123"}

### 30. Admin — 200
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password=Admin1234!

### 31. Salto inválido — 400
PATCH {{baseUrl}}/pedidos/{{pedidoEntregado.response.body.$.id}}/estado
Content-Type: application/json

{"estado":"ENTREGADO"}

### 32. Preparación — 200
PATCH {{baseUrl}}/pedidos/{{pedidoEntregado.response.body.$.id}}/estado
Content-Type: application/json

{"estado":"EN_PREPARACION"}

### 33. Entrega — 200
PATCH {{baseUrl}}/pedidos/{{pedidoEntregado.response.body.$.id}}/estado
Content-Type: application/json

{"estado":"ENTREGADO"}

### 34. Terminal no cancela — 400
PATCH {{baseUrl}}/pedidos/{{pedidoEntregado.response.body.$.id}}/estado
Content-Type: application/json

{"estado":"CANCELADO"}

### 35. Resumen — 200, incluye 100.5 de esta entrega; puede haber otros pedidos previos
GET {{baseUrl}}/pedidos/resumen

### 36. Listado paginado y filtrado — 200
GET {{baseUrl}}/pedidos?estado=ENTREGADO&skip=0&limit=1

### 37. No borrar pedidos — 405
DELETE {{baseUrl}}/pedidos/{{pedidoEntregado.response.body.$.id}}

### 38. No editar líneas — 405
PUT {{baseUrl}}/pedidos/{{pedidoEntregado.response.body.$.id}}
Content-Type: application/json

{"items":[]}
