@baseUrl = http://localhost:8000/api/v1
@marca = fase6_001

### 1. Logout para comenzar sin sesión — 200
POST {{baseUrl}}/auth/logout

### 2. Categorías públicas — 200
GET {{baseUrl}}/categorias

### 3. Productos públicos — 200, total e items
GET {{baseUrl}}/productos?skip=0&limit=20

### 4. Escritura sin sesión — 401
POST {{baseUrl}}/categorias
Content-Type: application/json

{"nombre":"No autorizada"}

### 5. Login administrador — 200, cookie
POST {{baseUrl}}/auth/token
Content-Type: application/x-www-form-urlencoded

username=admin&password=Admin1234!

### 6. Crear categoría — 201
# @name crearCategoria
POST {{baseUrl}}/categorias
Content-Type: application/json

{"nombre":"Bebidas {{marca}}","descripcion":"Prueba de catálogo"}

### 7. Duplicado — 409
POST {{baseUrl}}/categorias
Content-Type: application/json

{"nombre":"  Bebidas {{marca}}  "}

### 8. Nombre vacío — 422
POST {{baseUrl}}/categorias
Content-Type: application/json

{"nombre":"   "}

### 9. Detalle categoría — 200
GET {{baseUrl}}/categorias/{{crearCategoria.response.body.$.id}}

### 10. Edición parcial categoría — 200, nombre conservado
PUT {{baseUrl}}/categorias/{{crearCategoria.response.body.$.id}}
Content-Type: application/json

{"descripcion":"Descripción editada"}

### 11. Crear producto — 201
# @name crearProducto
POST {{baseUrl}}/productos
Content-Type: application/json

{"nombre":"Café {{marca}}","precio_base":1500,"stock":10,"categoria_id":{{crearCategoria.response.body.$.id}}}

### 12. Categoría inexistente — 404, no debe crear el producto
POST {{baseUrl}}/productos
Content-Type: application/json

{"nombre":"Referencia inválida {{marca}}","precio_base":100,"categoria_id":2147483647}

### 13. Stock negativo — 422
POST {{baseUrl}}/productos
Content-Type: application/json

{"nombre":"Inválido","precio_base":100,"stock":-1,"categoria_id":{{crearCategoria.response.body.$.id}}}

### 14. Buscar y paginar — 200
GET {{baseUrl}}/productos?search={{marca}}&categoria_id={{crearCategoria.response.body.$.id}}&skip=0&limit=1

### 15. Detalle producto — 200
GET {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}

### 16. Precio cero mediante edición parcial — 200
PUT {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}
Content-Type: application/json

{"precio_base":0}

### 17. Stock cero y disponibilidad false — 200
PATCH {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}/stock
Content-Type: application/json

{"stock":0,"disponible":false}

### 18. Filtro false — 200, incluye producto de prueba
GET {{baseUrl}}/productos?disponible=false&categoria_id={{crearCategoria.response.body.$.id}}

### 19. Edición rechazada — 404, nombre y precio deben conservarse
PUT {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}
Content-Type: application/json

{"nombre":"No debe guardarse","precio_base":999,"categoria_id":2147483647}

### 20. Verificar que no hubo modificación parcial — 200, nombre original y precio 0
GET {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}

### 21. Baja categoría con producto — 204
DELETE {{baseUrl}}/categorias/{{crearCategoria.response.body.$.id}}

### 22. Categoría de baja — 404
GET {{baseUrl}}/categorias/{{crearCategoria.response.body.$.id}}

### 23. Producto conservado — 200, categoría anidada inactiva
GET {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}

### 24. Nombre de categoría reservado — 409
POST {{baseUrl}}/categorias
Content-Type: application/json

{"nombre":"Bebidas {{marca}}"}

### 25. Baja producto — 204
DELETE {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}

### 26. Producto de baja — 404
GET {{baseUrl}}/productos/{{crearProducto.response.body.$.id}}

### 27. Confirmar exclusión del listado — 200, total 0
GET {{baseUrl}}/productos?categoria_id={{crearCategoria.response.body.$.id}}
